# Copy this file to .env and fill it in. .env is gitignored: never commit it.
ANTHROPIC_API_KEY=

# Optional settings (remove the # to use one)
# HOMECALL_MODEL=claude-sonnet-5-5   # faster and cheaper than the default claude-opus-5-5
# HOMECALL_EFFORT=low                # low = snappier replies, high = more careful
# HOMECALL_CODE=123456               # fixed pairing code while developing
# HOMECALL_PORT=8000
# HOMECALL_FPS_DELAY=0.5             # seconds between screen frames
