# Copy this file to .env and fill it in. .env is gitignored: never commit it.
ANTHROPIC_API_KEY=

# Which brain thinks: api (needs ANTHROPIC_API_KEY), max (Claude Code's login on this PC,
# e.g. a Max plan; also run: pip install claude-agent-sdk), or echo (no AI).
# Leave it out to use api when a key is set, echo otherwise.
# HOMECALL_BRAIN=max
# HOMECALL_MAX_MODEL=sonnet          # Claude Code model alias for the max brain; opus = smarter, slower
# HOMECALL_MAX_EFFORT=low            # low = snappy voice replies; medium/high = more careful

# Optional settings (remove the # to use one)
# HOMECALL_MODEL=claude-sonnet-5-5   # faster and cheaper than the default claude-opus-5-5
# HOMECALL_EFFORT=low                # low = snappier replies, high = more careful
# HOMECALL_CODE=123456               # fixed pairing code while developing
# HOMECALL_PORT=8000
# HOMECALL_FPS_DELAY=0.5             # seconds between screen frames
